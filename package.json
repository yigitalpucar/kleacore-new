{
  "name": "hostingtr",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:content": "node scripts/seed-content.mjs",
    "ops:cron:setup": "node scripts/setup-dokploy-schedules.mjs",
    "ops:cron:health": "node scripts/cron-healthcheck.mjs",
    "ops:smoke": "node scripts/smoke-production.mjs",
    "ops:smoke:extended": "node scripts/smoke-extended.mjs --with-cron --with-integrations",
    "ops:smoke:local": "SMOKE_BASE_URL=http://localhost:3000 node scripts/smoke-extended.mjs --with-auth",
    "ops:smoke:staging": "SMOKE_BASE_URL=https://staging.kleacore.com node scripts/smoke-extended.mjs --with-cron --with-integrations",
    "ops:configure": "node scripts/configure-production-settings.mjs",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@hookform/resolvers": "^3.3.4",
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "@radix-ui/react-accordion": "^1.1.2",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-navigation-menu": "^1.1.4",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-tooltip": "^1.0.7",
    "@tanstack/react-table": "^8.21.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "flag-icons": "^7.5.0",
    "framer-motion": "^11.0.3",
    "geist": "^1.2.2",
    "lucide-react": "^0.562.0",
    "next": "16.3.8",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.2.1",
    "nodemailer": "^10.0.16",
    "otpauth": "^9.5.1",
    "pg": "^8.19.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-hook-form": "^7.50.0",
    "sharp": "^0.35.5",
    "sonner": "^2.0.7",
    "stripe": "^22.2.0",
    "tailwind-merge": "^2.2.1",
    "zod": "^3.22.4",
    "zustand": "^4.5.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.16.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.0.1",
    "dotenv": "^17.3.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "postcss": "^8.5.29",
    "prisma": "^7.4.2",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
