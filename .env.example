# =============================================================================
# KLEACORE — Environment variables
# Copy to .env and fill in values for local development.
# =============================================================================

# --- Database ---
# PostgreSQL connection string (used by Prisma and @/lib/db)
DATABASE_URL="postgresql://kleacore:kleacore123@localhost:5432/kleacore"

# --- Auth (NextAuth v5) ---
# Session/JWT signing secret — generate with: openssl rand -base64 32
# NextAuth v5 reads AUTH_SECRET; NEXTAUTH_SECRET is supported as a fallback.
AUTH_SECRET=""
NEXTAUTH_SECRET=""
# Optional dedicated key for encrypting integration secrets in DB (falls back to AUTH_SECRET)
ENCRYPTION_KEY=""
# Admin password used only during `pnpm db:seed` (not stored in repo)
SEED_ADMIN_PASSWORD=""
# Canonical app URL for auth callbacks (server-side)
NEXTAUTH_URL="http://localhost:3000"

# --- Application URLs ---
# Public URL exposed to the browser (Stripe redirects, sitemap, etc.)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Server-side base URL (password reset links, internal redirects)
APP_URL="http://localhost:3000"

# --- Stripe ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- Payment gateways (optional; provider also selectable in admin) ---
# payment_gateway_provider: stripe | iyzico | paytr (default stripe, set in admin)
IYZICO_ENABLED="false"
IYZICO_API_KEY=""
IYZICO_SECRET_KEY=""
IYZICO_TEST_MODE="true"
PAYTR_ENABLED="false"
PAYTR_MERCHANT_ID=""
PAYTR_MERCHANT_KEY=""
PAYTR_MERCHANT_SALT=""
PAYTR_TEST_MODE="0"

# --- Cron ---
# Shared secret for scheduled job endpoints (/api/cron/*)
# Send as: Authorization: Bearer <CRON_SECRET>  or  x-cron-secret: <CRON_SECRET>
CRON_SECRET=""

# --- Outbound webhooks ---
# HMAC signing secret for outbound webhook payloads (order.paid, payment.completed, etc.)
WEBHOOK_SIGNING_SECRET=""

# --- Domain registrar integration (Gri B2B) ---
REGISTRAR_ENABLED="false"
REGISTRAR_PROVIDER="gri"
REGISTRAR_API_URL=""
REGISTRAR_API_KEY=""
REGISTRAR_USERNAME=""
REGISTRAR_PASSWORD=""
REGISTRAR_CLIENT_ID=""
REGISTRAR_CLIENT_SECRET=""
REGISTRAR_TEST_MODE="true"

# --- Service provisioning integration ---
PROVISIONING_ENABLED="false"
PROVISIONING_PROVIDER="disabled"
PROVISIONING_API_URL=""
PROVISIONING_API_KEY=""

# --- SMTP / email ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@kleacore.com"
EMAIL_FROM="noreply@kleacore.com"
EMAIL_NOTIFICATIONS="true"

# --- Dokploy (self-hosted deploy panel) ---
# API base must include /api — generate key in Dokploy Settings → API
DOKPLOY_URL="https://gold.kleacore.com/api"
DOKPLOY_API_KEY=""

# --- Runtime (optional) ---
NODE_ENV="development"
PORT="3000"