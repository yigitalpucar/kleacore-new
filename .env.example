# =============================================================================
# KLEACORE — Environment variables
# Copy to .env and fill in values for local development.
# =============================================================================

# --- Database ---
# PostgreSQL connection string (used by Prisma and @/lib/db)
DATABASE_URL="postgresql://kleacore:kleacore123@localhost:5432/kleacore"

# --- Auth (NextAuth v5) ---
# Session/JWT signing secret — generate with: openssl rand -base64 32
# NextAuth v5 reads AUTH_SECRET; NEXTAUTH_SECRET is supported as a fallback.
AUTH_SECRET=""
NEXTAUTH_SECRET=""
# Optional dedicated key for encrypting integration secrets in DB (falls back to AUTH_SECRET)
ENCRYPTION_KEY=""
# Admin password used only during `pnpm db:seed` (not stored in repo)
SEED_ADMIN_PASSWORD=""
# Canonical app URL for auth callbacks (server-side)
NEXTAUTH_URL="http://localhost:3000"

# --- Application URLs ---
# Public URL exposed to the browser (Stripe redirects, sitemap, etc.)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Server-side base URL (password reset links, internal redirects)
APP_URL="http://localhost:3000"

# --- Stripe ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- Payment gateways (optional; provider also selectable in admin) ---
# payment_gateway_provider: stripe | iyzico | paytr (default stripe, set in admin)
IYZICO_ENABLED="false"
IYZICO_API_KEY=""
IYZICO_SECRET_KEY=""
IYZICO_TEST_MODE="true"
PAYTR_ENABLED="false"
PAYTR_MERCHANT_ID=""
PAYTR_MERCHANT_KEY=""
PAYTR_MERCHANT_SALT=""
PAYTR_TEST_MODE="0"
# Saved cards + automatic collection via PayTR Kart Saklama (docs/payments-saved-cards.md).
# Admin: Faturalar → Otomatik tahsilat overrides these.
SAVED_CARDS_ENABLED="false"
AUTO_CHARGE_MAX_ATTEMPTS="3"
AUTO_CHARGE_GRACE_DAYS="3"
# Kuveyt Türk Sanal POS (3D Model). Admin > Entegrasyonlar > Ödeme overrides these.
KUVEYTTURK_ENABLED="false"
KUVEYTTURK_MERCHANT_ID=""
KUVEYTTURK_CUSTOMER_ID=""
KUVEYTTURK_USERNAME=""
KUVEYTTURK_PASSWORD=""
KUVEYTTURK_TEST_MODE="true"

# --- Cron ---
# Shared secret for scheduled job endpoints (/api/cron/*)
# Send as: Authorization: Bearer <CRON_SECRET>  or  x-cron-secret: <CRON_SECRET>
CRON_SECRET=""
# Optional: cron-job.org API key for scripts/setup-cron-jobs.mjs --register
CRON_JOB_ORG_API_KEY=""
# Optional: IANA timezone for external schedulers (default Europe/Istanbul)
CRON_TIMEZONE="Europe/Istanbul"

# --- Outbound webhooks ---
# HMAC signing secret for outbound webhook payloads (order.paid, payment.completed, etc.)
WEBHOOK_SIGNING_SECRET=""

# --- Domain registrar integration (Gri B2B) ---
REGISTRAR_ENABLED="false"
REGISTRAR_PROVIDER="gri"
REGISTRAR_API_URL=""
REGISTRAR_API_KEY=""
REGISTRAR_USERNAME=""
REGISTRAR_PASSWORD=""
REGISTRAR_CLIENT_ID=""
REGISTRAR_CLIENT_SECRET=""
REGISTRAR_TEST_MODE="true"

# --- Service provisioning integration ---
PROVISIONING_ENABLED="false"
PROVISIONING_PROVIDER="disabled"
PROVISIONING_API_URL=""
PROVISIONING_API_KEY=""

# --- Upload storage (ticket attachments; docs/ops-storage.md) ---
# local (default): files under STORAGE_LOCAL_DIR — production: /app/uploads (Docker volume)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR=""
# s3: any S3-compatible private bucket (AWS S3, Cloudflare R2, MinIO)
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"

# --- SMTP / email ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@kleacore.com"
EMAIL_FROM="noreply@kleacore.com"
EMAIL_NOTIFICATIONS="true"

# --- Dokploy (self-hosted deploy panel) ---
# API base must include /api — generate key in Dokploy Settings → API
DOKPLOY_URL="https://gold.kleacore.com/api"
DOKPLOY_API_KEY=""

# --- Runtime (optional) ---
NODE_ENV="development"
PORT="3000"
# --- Cloudflare Turnstile (bot protection: register, password reset, contact, login after failures) ---
# Production: real keys from the Cloudflare dashboard (managed widget). Without keys the
# protected forms are bypassed with an error log (fail closed only when TURNSTILE_REQUIRED=true);
# outside production they are bypassed with a warning.
# Local development: Cloudflare's always-pass test keys:
#   TURNSTILE_SITE_KEY="1x00000000000000000000AA"
#   TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
# Set to true once the keys are in place: production then rejects forms if the keys go missing.
TURNSTILE_REQUIRED=
# Keys can also be set in Yönetim > Ayarlar > Güvenlik (env wins).
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
# Failed logins (per e-mail or IP, 15 min) before the login form requires Turnstile.
LOGIN_CAPTCHA_AFTER_FAILURES="3"
