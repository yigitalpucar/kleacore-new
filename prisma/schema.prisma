generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =====================
// ENUMS
// =====================

enum UserRole {
  ADMIN
  CUSTOMER
  // Staff roles (3.6): permissions live in src/lib/auth/permissions.ts
  SUPPORT
  BILLING
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum CustomerType {
  INDIVIDUAL
  CORPORATE
}

enum ProductCategorySlug {
  hosting
  vds
  vps
  server
  cloud
  datacenter
  domain
  ssl
  email
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DRAFT
  ARCHIVED
}

enum BillingPeriod {
  monthly
  quarterly
  semiannual
  yearly
  biennial
  triennial
}

enum OrderStatus {
  PENDING
  APPROVED
  PROCESSING
  COMPLETED
  CANCELLED
  REFUNDED
}

enum ServiceStatus {
  // Paid, waiting for manual provisioning (admin task) — "Kurulum sürüyor"
  PENDING
  ACTIVE
  SUSPENDED
  CANCELLED
  EXPIRED
}

enum CancellationRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProvisioningJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ProvisioningJobKind {
  PROVISION
  UNSUSPEND
  /// Remote package change (WHM changepackage / VPS resize) of a paid plan change.
  PLAN_CHANGE
  // No automation module (VDS in Faz 1, unconfigured panels): admin task
  MANUAL
}

enum NotificationChannel {
  EMAIL
  SMS
}

enum NotificationLogStatus {
  QUEUED
  SENT
  FAILED
  // Not attempted: channel disabled / not configured, no phone number
  SKIPPED
}

enum PlanChangeType {
  UPGRADE
  DOWNGRADE
}

enum PlanChangeStatus {
  PENDING
  PAYMENT_PENDING
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  PENDING
  PAID
  OVERDUE
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum RefundStatus {
  PENDING
  COMPLETED
  FAILED
}

/// How the money goes back: through the card gateway that charged it, as
/// account balance, or recorded after an out-of-band transfer (havale).
enum RefundMethod {
  GATEWAY
  BALANCE
  MANUAL
}

enum BankTransferNoticeStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EInvoiceStatus {
  DRAFT
  QUEUED
  SENT
  ACCEPTED
  REJECTED
  FAILED
  CANCELLED
}

enum PaymentMethod {
  CREDIT_CARD
  BANK_TRANSFER
  BALANCE
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum TicketStatus {
  OPEN
  CUSTOMER_REPLY
  ADMIN_REPLY
  WAITING
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketDepartment {
  GENERAL
  TECHNICAL
  BILLING
  SALES
}

/// Where a ticket was opened.
enum TicketSource {
  WEB
  EMAIL
  API
}

enum InboundEmailStatus {
  /// Turned into a new ticket or a reply.
  PROCESSED
  /// Deliberately skipped (auto-reply, bounce, our own mail, rate limit).
  IGNORED
  /// Processing threw; the message stays unread in the mailbox for the next poll.
  FAILED
}

enum DnsRecordType {
  A
  AAAA
  CNAME
  MX
  TXT
  NS
  SRV
  CAA
}

enum DomainStatus {
  ACTIVE
  EXPIRED
  TRANSFERRING
  PENDING
}

enum SslStatus {
  ACTIVE
  EXPIRED
  PENDING
  REVOKED
}

enum SslType {
  DV
  OV
  EV
  WILDCARD
}

enum BackupStatus {
  COMPLETED
  IN_PROGRESS
  FAILED
  SCHEDULED
}

enum BackupType {
  FULL
  INCREMENTAL
  DATABASE
  FILES
}

enum TransactionType {
  DEPOSIT
  PAYMENT
  REFUND
  ADJUSTMENT
}

enum PromoCodeStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum NotificationType {
  INFO
  WARNING
  ERROR
  SUCCESS
}

enum SystemStatusType {
  OPERATIONAL
  DEGRADED
  PARTIAL_OUTAGE
  MAJOR_OUTAGE
  MAINTENANCE
}

enum IncidentSeverity {
  MINOR
  MAJOR
  CRITICAL
}

enum IncidentStatus {
  INVESTIGATING
  IDENTIFIED
  MONITORING
  RESOLVED
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum KbArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AffiliatePaymentStatus {
  PENDING
  PAID
  CANCELLED
}

enum EmailMessageCategory {
  BILLING
  SUPPORT
  SYSTEM
  SERVICE
  SECURITY
  PROMOTION
}

enum EmailAccountStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

// =====================
// AUTH / USER
// =====================

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  password     String
  name         String
  surname      String       @default("")
  phone        String?
  role         UserRole     @default(CUSTOMER)
  status       UserStatus   @default(ACTIVE)
  customerType CustomerType @default(INDIVIDUAL)

  // Company info (corporate customers)
  companyName String?
  taxNumber   String?
  taxOffice   String?

  // Address
  address String?
  city    String?
  country String  @default("Türkiye")

  // Two-factor authentication
  twoFactorEnabled      Boolean @default(false)
  twoFactorSecret       String?
  twoFactorBackupCodes  String?
  // Last accepted TOTP time step; codes at or before it are rejected (replay protection)
  twoFactorLastUsedStep Int?
  // sha256 of the one-time nonce inside the short-lived "verified" login token
  loginTokenNonceHash   String?

  // Bumped on password change/reset; JWTs carrying an older value are revoked
  sessionVersion Int @default(0)

  // Balance
  balance Decimal @default(0) @db.Decimal(14, 2)

  // Affiliate
  affiliateCode       String? @unique
  affiliatePayoutIban String?
  referredById        String?
  referredBy          User?   @relation("Referrals", fields: [referredById], references: [id])
  referrals           User[]  @relation("Referrals")

  // Reseller
  isReseller              Boolean @default(false)
  resellerDiscountPercent Decimal @default(0) @db.Decimal(5, 2)
  parentResellerId        String?
  parentReseller          User?   @relation("ResellerCustomers", fields: [parentResellerId], references: [id])
  resellerCustomers       User[]  @relation("ResellerCustomers")

  // Relations
  orders                  Order[]
  services                Service[]
  invoices                Invoice[]
  payments                Payment[]
  tickets                 SupportTicket[]
  domains                 Domain[]
  sslCertificates         SslCertificate[]
  transactions            Transaction[]
  notifications           Notification[]
  activityLogs            ActivityLog[]
  apiKeys                 ApiKey[]
  sessions                Session[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  consentRecords          ConsentRecord[]
  backups                 Backup[]
  emailMessages           EmailMessage[]
  emailAccounts           EmailAccount[]
  cancellationRequests    CancellationRequest[]
  planChanges             ServicePlanChange[]
  notificationLogs        NotificationLog[]
  bankTransferNotices     BankTransferNotice[]
  importRuns              ImportRun[]
  savedCards              SavedCard[]
  paymentAttempts         PaymentAttempt[]

  // Affiliate relations
  affiliateReferrals AffiliateReferral[] @relation("AffiliateReferrals")
  referredReferrals  AffiliateReferral[] @relation("ReferredReferrals")
  affiliatePayments  AffiliatePayment[]

  // Otomatik ödeme (Faz 3.7): vadesi gelen faturalar varsayılan kayıtlı karttan
  // çekilir. Açılırken müşterinin onayı (zaman + IP) kaydedilir.
  autoPayEnabled   Boolean   @default(false)
  autoPayConsentAt DateTime?
  autoPayConsentIp String?

  // KYC (Faz 4, docs/fraud-kyc.md): identity verification required before
  // server products (5651) are provisioned. Documents in KycDocument.
  kycStatus          KycStatus     @default(NONE)
  kycSubmittedAt     DateTime?
  kycReviewedAt      DateTime?
  kycReviewedBy      String?
  kycRejectionReason String?
  kycDocuments       KycDocument[]

  // Timestamps
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([parentResellerId])
  @@map("users")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
  userAgent    String?
  ipAddress    String?
  createdAt    DateTime @default(now())

  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

/// Single-use e-mail verification link token. Only the sha256 of the random
/// token is stored (like PasswordResetToken).
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
  @@map("email_verification_tokens")
}

// =====================
// PRODUCTS
// =====================

model ProductCategory {
  id           String              @id @default(cuid())
  slug         ProductCategorySlug @unique
  name         String
  description  String              @default("")
  icon         String              @default("Package")
  displayOrder Int                 @default(0)
  isActive     Boolean             @default(true)
  features     ProductFeature[]
  products     Product[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@map("product_categories")
}

model ProductFeature {
  id            String              @id @default(cuid())
  categoryId    ProductCategorySlug
  category      ProductCategory     @relation(fields: [categoryId], references: [slug])
  name          String
  slug          String
  unit          String              @default("")
  icon          String              @default("Tag")
  isHighlighted Boolean             @default(false)
  displayOrder  Int                 @default(0)
  isActive      Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([categoryId, slug])
  @@index([categoryId, displayOrder])
  @@map("product_features")
}

model Product {
  id               String          @id @default(cuid())
  categoryId       String
  category         ProductCategory @relation(fields: [categoryId], references: [id])
  sku              String          @unique
  name             String
  slug             String          @unique
  shortDescription String          @default("")
  longDescription  String          @default("")

  // Sub-type for category sub-pages (e.g. hosting: linux/wordpress/reseller/kurumsal)
  subType String @default("")

  // Features stored as JSON
  features         Json @default("[]")
  includedFeatures Json @default("[]")
  resourceLimits   Json @default("{}")

  // FAQ stored as JSON [{question: string, answer: string}]
  faq Json @default("[]")

  // Pricing
  basePrice    Decimal       @default(0) @db.Decimal(14, 2)
  pricingTiers PricingTier[]

  // Display
  badge        String?
  isPopular    Boolean @default(false)
  displayOrder Int     @default(0)

  // Stock
  stockQuantity Int     @default(-1)
  isInStock     Boolean @default(true)

  // Status
  status    ProductStatus @default(DRAFT)
  isVisible Boolean       @default(true)

  // SEO
  metaTitle       String?
  metaDescription String?

  // Automation binding (Faz 2.2): which module instance provisions this
  // product and its module-specific options (validated by the module's
  // productOptionsSchema, e.g. WHM package / Proxmox template + resources).
  // NULL = legacy resolution by category (Settings-backed WHM/VPS or MANUAL).
  moduleInstanceId String?
  moduleInstance   ModuleInstance? @relation(fields: [moduleInstanceId], references: [id], onDelete: SetNull)
  moduleOptions    Json            @default("{}")

  // Relations
  orders          Order[]
  services        Service[]
  planChangesFrom ServicePlanChange[]   @relation("PlanChangeFrom")
  planChangesTo   ServicePlanChange[]   @relation("PlanChangeTo")
  configOptions   ProductConfigOption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([moduleInstanceId])
  @@map("products")
}

model ProductConfigOption {
  id              String   @id @default(cuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name            String
  slug            String
  optionType      String   @default("select") // select | quantity
  choices         Json     @default("[]") // [{value, label, priceMonthly, priceYearly}]
  minValue        Int?
  maxValue        Int?
  unitPrice       Decimal  @default(0) @db.Decimal(14, 2) // for quantity type (monthly)
  unitPriceYearly Decimal  @default(0) @db.Decimal(14, 2)
  isRequired      Boolean  @default(false)
  displayOrder    Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([productId, slug])
  @@map("product_config_options")
}

model PricingTier {
  id              String        @id @default(cuid())
  productId       String
  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  period          BillingPeriod
  price           Decimal       @db.Decimal(14, 2)
  discountedPrice Decimal?      @db.Decimal(14, 2)
  setupFee        Decimal       @default(0) @db.Decimal(14, 2)
  renewalPrice    Decimal       @default(0) @db.Decimal(14, 2)
  isDefault       Boolean       @default(false)
  isActive        Boolean       @default(true)

  @@unique([productId, period])
  @@map("pricing_tiers")
}

// =====================
// ORDERS
// =====================

model Order {
  id          String  @id @default(cuid())
  orderNumber String  @unique
  customerId  String
  customer    User    @relation(fields: [customerId], references: [id])
  productId   String
  product     Product @relation(fields: [productId], references: [id])

  // Config
  domain        String?
  billingPeriod BillingPeriod @default(monthly)
  quantity      Int           @default(1)

  // Pricing
  basePrice      Decimal        @default(0) @db.Decimal(14, 2)
  discountAmount Decimal        @default(0) @db.Decimal(14, 2)
  promoCodeId    String?
  promoCode      PromotionCode? @relation(fields: [promoCodeId], references: [id])
  setupFee       Decimal        @default(0) @db.Decimal(14, 2)
  taxRate        Decimal        @default(20) @db.Decimal(5, 2)
  taxAmount      Decimal        @default(0) @db.Decimal(14, 2)
  totalAmount    Decimal        @default(0) @db.Decimal(14, 2)

  // Status
  status              OrderStatus @default(PENDING)
  approvedAt          DateTime?
  approvedBy          String?
  processingStartedAt DateTime?
  completedAt         DateTime?
  cancelledAt         DateTime?
  cancellationReason  String?
  refundedAt          DateTime?
  refundAmount        Decimal?    @db.Decimal(14, 2)

  // Related
  serviceId String?
  invoiceId String?

  // Notes
  customerNotes String?
  adminNotes    String?

  // Relations
  items                OrderItem[]
  activities           OrderActivity[]
  invoice              Invoice?
  cancellationRequests CancellationRequest[]
  provisioningJob      ProvisioningJob?
  planChanges          ServicePlanChange[]
  consentRecords       ConsentRecord[]
  fraudCheck           FraudCheck?

  // Paid but provisioning waits (fraud review and/or KYC, docs/fraud-kyc.md).
  // Cleared exactly once when the order is released or rejected.
  provisioningHeldAt      DateTime?
  provisioningHoldReasons String[]  @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("orders")
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productName    String
  productSku     String
  quantity       Int     @default(1)
  unitPrice      Decimal @db.Decimal(14, 2)
  discountAmount Decimal @default(0) @db.Decimal(14, 2)
  totalPrice     Decimal @db.Decimal(14, 2)
  configuration  Json    @default("{}")

  @@map("order_items")
}

model OrderActivity {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  action      String
  description String
  performedBy String
  metadata    Json?
  createdAt   DateTime @default(now())

  @@map("order_activities")
}

// =====================
// SERVICES
// =====================

model Service {
  id         String  @id @default(cuid())
  customerId String
  customer   User    @relation(fields: [customerId], references: [id])
  productId  String
  product    Product @relation(fields: [productId], references: [id])

  // Service details
  label      String  @default("")
  domain     String?
  username   String?
  ipAddress  String?
  /// Free text kept for history (legacy WHM username / VPS id). New code
  /// writes moduleInstanceId + remoteId instead.
  serverName String?

  // Module binding (Faz 2.2): the instance the remote account lives on and
  // its id there (WHM username / Proxmox VMID). NULL = legacy service.
  moduleInstanceId String?
  moduleInstance   ModuleInstance? @relation(fields: [moduleInstanceId], references: [id], onDelete: SetNull)
  remoteId         String?
  /// Module-owned state keyed by moduleId (Proxmox: VMID, node, resumable
  /// provisioning step, last task UPID, encrypted initial password). Never
  /// sent to the browser as-is; see src/lib/modules/service-state.ts.
  moduleData       Json?

  // Resources. Disk / bandwidth in GB (bandwidth = current month); hosting
  // accounts are refreshed daily from the panel (hosting.usage-sync job),
  // usageSyncedAt = last successful sync. A null limit after a sync means
  // "unlimited" on the panel.
  diskUsed       Float?
  diskLimit      Float?
  bandwidthUsed  Float?
  bandwidthLimit Float?
  cpuUsage       Float?
  ramUsage       Float?
  usageSyncedAt  DateTime?

  /// Control panel (cPanel) password generated at createAccount or by the
  /// customer's "Şifreyi sıfırla"; encrypted (enc:v1:, src/lib/secrets/crypto).
  /// Never logged, never sent to the browser except an explicit reveal.
  panelPassword      String?
  panelPasswordSetAt DateTime?

  // Billing
  billingPeriod BillingPeriod @default(monthly)
  amount        Decimal       @default(0) @db.Decimal(14, 2)
  nextDueDate   DateTime?
  expiresAt     DateTime?

  // Status
  status        ServiceStatus @default(ACTIVE)
  suspendedAt   DateTime?
  cancelledAt   DateTime?
  suspendReason String?

  // Relations
  backups              Backup[]
  cancellationRequests CancellationRequest[]
  provisioningJobs     ProvisioningJob[]
  planChanges          ServicePlanChange[]
  emailAccounts        EmailAccount[]
  ipAddresses          IpAddress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One service per remote account: imports (2.7) and provisioning can never
  /// bind two services to the same WHM user / VMID on an instance. Legacy rows
  /// (NULL instance or remoteId) are not constrained.
  @@unique([moduleInstanceId, remoteId])
  @@index([moduleInstanceId])
  @@map("services")
}

model ServicePlanChange {
  id             String           @id @default(cuid())
  serviceId      String
  service        Service          @relation(fields: [serviceId], references: [id])
  customerId     String
  customer       User             @relation(fields: [customerId], references: [id])
  fromProductId  String
  fromProduct    Product          @relation("PlanChangeFrom", fields: [fromProductId], references: [id])
  toProductId    String
  toProduct      Product          @relation("PlanChangeTo", fields: [toProductId], references: [id])
  type           PlanChangeType
  status         PlanChangeStatus @default(PENDING)
  proratedAmount Decimal          @default(0) @db.Decimal(14, 2)
  orderId        String?
  order          Order?           @relation(fields: [orderId], references: [id])
  invoiceId      String?
  notes          String?
  requestedAt    DateTime         @default(now())
  completedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@map("service_plan_changes")
}

model CancellationRequest {
  id         String                    @id @default(cuid())
  customerId String
  customer   User                      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  serviceId  String?
  service    Service?                  @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  orderId    String?
  order      Order?                    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  reason     String
  status     CancellationRequestStatus @default(PENDING)
  createdAt  DateTime                  @default(now())
  resolvedAt DateTime?
  adminNotes String?

  @@index([customerId])
  @@index([orderId])
  @@index([serviceId])
  @@index([status])
  @@map("cancellation_requests")
}

model ProvisioningJob {
  id          String                @id @default(cuid())
  orderId     String                @unique
  order       Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  serviceId   String?
  service     Service?              @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  kind        ProvisioningJobKind   @default(PROVISION)
  status      ProvisioningJobStatus @default(PENDING)
  attempts    Int                   @default(0)
  maxAttempts Int                   @default(5)
  lastError   String?
  nextRetryAt DateTime
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  completedAt DateTime?

  // MANUAL jobs: delivery details entered by the admin on activation.
  // Sensitive values (initial password) are stored encrypted (enc:v1:...).
  deliveryDetails Json?
  completedBy     String?

  @@index([status, nextRetryAt])
  @@index([kind, status])
  @@map("provisioning_jobs")
}

// =====================
// DOMAINS
// =====================

model Domain {
  id             String       @id @default(cuid())
  customerId     String
  customer       User         @relation(fields: [customerId], references: [id])
  name           String       @unique
  registrar      String       @default("KLEACORE")
  registeredAt   DateTime     @default(now())
  expiresAt      DateTime
  autoRenew      Boolean      @default(true)
  privacyEnabled Boolean      @default(false)
  status         DomainStatus @default(ACTIVE)
  nameservers    Json         @default("[]")
  /// Last successful registrar status sync (daily domain-sync cron).
  lastSyncedAt   DateTime?

  /// Registrar module instance the domain was imported from (2.7); the
  /// domain name itself is the remote id. NULL = Settings-backed registrar.
  moduleInstanceId String?
  moduleInstance   ModuleInstance? @relation(fields: [moduleInstanceId], references: [id], onDelete: SetNull)

  // WHOIS
  whoisName    String?
  whoisEmail   String?
  whoisPhone   String?
  whoisAddress String?

  // DNS
  dnsRecords    DnsRecord[]
  /// Set when the domain's DNS is hosted by a DNS module (Cloudflare).
  dnsZone       DnsZone?
  emailAccounts EmailAccount[]

  // Lifecycle (renewal invoices, registrar renew, expiry notices, sync)
  renewals        DomainRenewal[]
  notices         DomainNotice[]
  lifecycleEvents DomainLifecycleEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([moduleInstanceId])
  @@map("domains")
}

enum DomainRenewalStatus {
  /// Renewal invoice issued, waiting for payment.
  PENDING
  /// Invoice paid; registrar renew queued (domain.renew).
  PAID
  /// A registrar renew attempt is running.
  PROCESSING
  COMPLETED
  /// Registrar renew failed after all retries (admin action needed).
  FAILED
  /// Invoice cancelled before payment.
  CANCELLED
}

/// One renewal period of a domain: the invoice that bills it and the
/// registrar renew that fulfils it. `(domainId, periodStart)` is unique, so a
/// period never gets a second renewal invoice (periodStart = the expiresAt the
/// renewal extends from).
model DomainRenewal {
  id           String              @id @default(cuid())
  domainId     String
  domain       Domain              @relation(fields: [domainId], references: [id], onDelete: Cascade)
  /// Null for an admin renew without invoice.
  invoiceId    String?             @unique
  invoice      Invoice?            @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  periodStart  DateTime
  years        Int                 @default(1)
  status       DomainRenewalStatus @default(PENDING)
  /// cron | customer | admin
  source       String              @default("cron")
  attempts     Int                 @default(0)
  lastError    String?
  newExpiresAt DateTime?
  renewedAt    DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([domainId, periodStart])
  @@index([status])
  @@map("domain_renewals")
}

/// Sent-marker of an expiry notice: one per domain + kind + period.
model DomainNotice {
  id          String   @id @default(cuid())
  domainId    String
  domain      Domain   @relation(fields: [domainId], references: [id], onDelete: Cascade)
  /// expiring_30 | expiring_7 | expiring_1 | expired | grace_ending | redemption
  kind        String
  /// The domain's expiresAt the notice was about.
  periodStart DateTime
  sentAt      DateTime @default(now())

  @@unique([domainId, kind, periodStart])
  @@map("domain_notices")
}

/// Admin-visible lifecycle history of a domain (renewals, sync diffs, notices).
model DomainLifecycleEvent {
  id        String   @id @default(cuid())
  domainId  String
  domain    Domain   @relation(fields: [domainId], references: [id], onDelete: Cascade)
  type      String
  message   String
  details   Json?
  /// User who triggered it; null for cron/queue.
  actorId   String?
  createdAt DateTime @default(now())

  @@index([domainId, createdAt])
  @@map("domain_lifecycle_events")
}

/// DNS records of a domain. Without a DnsZone these rows are the source of
/// truth (legacy registrar mode). With a DnsZone they are a mirror of the
/// provider zone (providerRecordId set), refreshed after every change and on
/// sync — docs/dns-cloudflare.md.
model DnsRecord {
  id       String        @id @default(cuid())
  domainId String
  domain   Domain        @relation(fields: [domainId], references: [id], onDelete: Cascade)
  type     DnsRecordType
  name     String
  value    String
  ttl      Int           @default(3600)
  priority Int?

  /// Record id at the DNS provider (Cloudflare) when the domain has a zone.
  providerRecordId String?
  /// Cloudflare proxy (A/AAAA/CNAME).
  proxied          Boolean @default(false)
  /// Records KLEACORE manages for a service ("service:<id>"): shown as
  /// protected, customers can't edit or delete them.
  managedBy        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([domainId, providerRecordId])
  @@index([domainId])
  @@map("dns_records")
}

enum DnsZoneStatus {
  /// Zone exists at the provider; the domain's nameservers don't point at it yet.
  PENDING
  /// Provider reports the zone active (nameservers point at it).
  ACTIVE
  /// The last provider call for this zone failed (see lastError).
  ERROR
}

/// A domain's zone at a DNS module instance (Cloudflare). One per domain.
model DnsZone {
  id               String          @id @default(cuid())
  domainId         String          @unique
  domain           Domain          @relation(fields: [domainId], references: [id], onDelete: Cascade)
  moduleInstanceId String?
  moduleInstance   ModuleInstance? @relation(fields: [moduleInstanceId], references: [id], onDelete: SetNull)
  providerZoneId   String
  /// Nameservers the registrar must point at (shown to the customer).
  nameservers      String[]        @default([])
  status           DnsZoneStatus   @default(PENDING)
  /// Raw provider status ("pending", "active", "moved" …).
  providerStatus   String?
  lastSyncedAt     DateTime?
  lastError        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([moduleInstanceId])
  @@index([status])
  @@map("dns_zones")
}

