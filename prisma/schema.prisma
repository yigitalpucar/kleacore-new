// EMAIL
// =====================

model EmailAccount {
  id            String             @id @default(cuid())
  customerId    String
  customer      User               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  serviceId     String?
  service       Service?           @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  domainId      String?
  domain        Domain?            @relation(fields: [domainId], references: [id], onDelete: SetNull)
  localPart     String
  email         String             @unique
  passwordHash  String?
  quotaMb       Int                @default(2048)
  usedMb        Int                @default(0)
  status        EmailAccountStatus @default(ACTIVE)
  forwardTo     String?
  autoResponder Boolean            @default(false)
  lastLoginAt   DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([customerId, status])
  @@index([serviceId])
  @@map("email_accounts")
}

model EmailMessage {
  id         String               @id @default(cuid())
  customerId String
  customer   User                 @relation(fields: [customerId], references: [id], onDelete: Cascade)
  subject    String
  preview    String               @default("")
  content    String               @default("")
  category   EmailMessageCategory @default(SYSTEM)
  isRead     Boolean              @default(false)
  sentAt     DateTime             @default(now())
  readAt     DateTime?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@index([customerId, sentAt])
  @@map("email_messages")
}

// =====================
// INVOICES & PAYMENTS
// =====================

model Invoice {
  id            String  @id @default(cuid())
  invoiceNumber String  @unique
  customerId    String
  customer      User    @relation(fields: [customerId], references: [id])
  orderId       String? @unique
  order         Order?  @relation(fields: [orderId], references: [id])

  // Amounts
  subtotal       Decimal @default(0) @db.Decimal(14, 2)
  taxRate        Decimal @default(20) @db.Decimal(5, 2)
  taxAmount      Decimal @default(0) @db.Decimal(14, 2)
  totalAmount    Decimal @default(0) @db.Decimal(14, 2)
  paidAmount     Decimal @default(0) @db.Decimal(14, 2)
  /// Sum of COMPLETED refunds; paidAmount - refundedAmount is still held.
  refundedAmount Decimal @default(0) @db.Decimal(14, 2)

  // Status
  status   InvoiceStatus @default(PENDING)
  issuedAt DateTime      @default(now())
  dueDate  DateTime
  paidAt   DateTime?

  // Notes
  notes String?

  // Relations
  items               InvoiceItem[]
  payments            Payment[]
  eInvoiceRecord      EInvoiceRecord?
  domainRenewal       DomainRenewal?
  refunds             Refund[]
  bankTransferNotices BankTransferNotice[]
  paymentAttempts     PaymentAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Reports aggregate paid invoices by paidAt (src/lib/reports/*).
  @@index([status, paidAt])
  @@map("invoices")
}

model EInvoiceRecord {
  id               String         @id @default(cuid())
  invoiceId        String         @unique
  invoice          Invoice        @relation(fields: [invoiceId], references: [id])
  customerId       String
  type             String // "e-fatura" | "e-arsiv"
  status           EInvoiceStatus @default(DRAFT)
  documentUuid     String?
  documentNumber   String?        @unique
  ublPayload       Json?
  providerResponse Json?
  errorMessage     String?
  sentAt           DateTime?
  // "uyumsoft" | "parasut"; null on rows created before the provider split.
  provider         String?
  profile          String? // TEMELFATURA | TICARIFATURA | EARSIVFATURA
  providerStatus   String? // raw entegratör status (e.g. Uyumsoft "Approved")
  attempts         Int            @default(0)
  lastAttemptAt    DateTime?
  statusCheckedAt  DateTime?
  cancelledAt      DateTime?
  cancelReason     String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([status])
  @@map("e_invoice_records")
}

model InvoiceItem {
  id             String  @id @default(cuid())
  invoiceId      String
  invoice        Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description    String
  quantity       Int     @default(1)
  /// Net (KDV hariç) birim fiyat, indirim öncesi.
  unitPrice      Decimal @db.Decimal(14, 2)
  /// Satır indirimi (promosyon, bayi, dönem indirimi), net.
  discountAmount Decimal @default(0) @db.Decimal(14, 2)
  /// Net (KDV hariç) satır toplamı = unitPrice × quantity − discountAmount.
  /// KDV fatura düzeyinde hesaplanır: Σ totalPrice = invoice.subtotal.
  totalPrice     Decimal @db.Decimal(14, 2)

  @@map("invoice_items")
}

model Payment {
  id            String        @id @default(cuid())
  invoiceId     String
  invoice       Invoice       @relation(fields: [invoiceId], references: [id])
  customerId    String
  customer      User          @relation(fields: [customerId], references: [id])
  amount        Decimal       @db.Decimal(14, 2)
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  transactionId String?
  notes         String?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  /// Gateway references needed after the callback (bank order id, RRN,
  /// provision number for refunds) and the provisioning claim. Never card data.
  gatewayData   Json?
  refunds       Refund[]

  // One row per invoice per gateway session: a callback for any session
  // matches exactly one payment of each invoice it covers.
  @@unique([invoiceId, transactionId])
  @@index([transactionId])
  /// Collections report (tahsilat by day/month and method).
  @@index([status, paidAt])
  @@map("payments")
}

/// Money returned for a paid invoice. Rows in PENDING or COMPLETED count
/// against the refundable amount, so a refund whose gateway outcome is
/// unknown can never be repeated by accident.
model Refund {
  id             String       @id @default(cuid())
  invoiceId      String
  invoice        Invoice      @relation(fields: [invoiceId], references: [id])
  paymentId      String?
  payment        Payment?     @relation(fields: [paymentId], references: [id])
  customerId     String
  amount         Decimal      @db.Decimal(14, 2)
  reason         String
  method         RefundMethod
  /// "kuveytturk" | "paytr" | "iyzico" | "stripe" for GATEWAY refunds.
  gateway        String?
  /// Gateway operation (SaleReversal, DrawBack, …) or manual reference.
  operation      String?
  gatewayRef     String?
  gatewayData    Json?
  status         RefundStatus @default(PENDING)
  errorMessage   String?
  /// "CANCEL" | "KEEP" — what the admin chose for the related service.
  serviceAction  String       @default("KEEP")
  /// e-Arşiv cancelled ("EARSIV_CANCELLED") or a return invoice is needed
  /// ("RETURN_INVOICE_REQUIRED"); null when no official invoice was issued.
  eInvoiceAction String?
  /// Set by the admin dialog once per submit: a double click inserts nothing.
  idempotencyKey String       @unique
  createdBy      String
  createdAt      DateTime     @default(now())
  completedAt    DateTime?

  @@index([invoiceId])
  @@index([status])
  @@map("refunds")
}

/// Bank account shown to customers for havale/EFT payments.
model BankAccount {
  id          String   @id @default(cuid())
  bankName    String
  branch      String   @default("")
  accountName String
  iban        String   @unique
  currency    String   @default("TRY")
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  notices BankTransferNotice[]

  @@map("bank_accounts")
}

/// "Ödeme bildirimi": the customer says a transfer was sent; an admin
/// approves it (invoice paid through fulfilment) or rejects it with a reason.
model BankTransferNotice {
  id              String                   @id @default(cuid())
  invoiceId       String
  invoice         Invoice                  @relation(fields: [invoiceId], references: [id])
  customerId      String
  customer        User                     @relation(fields: [customerId], references: [id])
  bankAccountId   String?
  bankAccount     BankAccount?             @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  amount          Decimal                  @db.Decimal(14, 2)
  transferDate    DateTime
  senderName      String
  note            String?
  status          BankTransferNoticeStatus @default(PENDING)
  rejectionReason String?
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@index([status, createdAt])
  @@index([invoiceId])
  @@map("bank_transfer_notices")
}

model StripeWebhookEvent {
  id          String   @id @default(cuid())
  eventId     String   @unique
  processedAt DateTime @default(now())

  @@map("stripe_webhook_events")
}

// =====================
// SUPPORT
// =====================

model SupportTicket {
  id               String           @id @default(cuid())
  ticketNumber     String           @unique
  /// Null for a ticket opened by e-mail from an address that matches no
  /// verified customer (guestEmail is set; the admin list flags it).
  customerId       String?
  customer         User?            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  guestEmail       String?
  guestName        String?
  source           TicketSource     @default(WEB)
  subject          String
  department       TicketDepartment @default(GENERAL)
  priority         TicketPriority   @default(MEDIUM)
  status           TicketStatus     @default(OPEN)
  assignedTo       String?
  relatedServiceId String?

  /// Set while the ball is in the customer's court (ADMIN_REPLY / WAITING);
  /// the auto-close cron counts from here. Cleared on a customer reply.
  waitingSince      DateTime?
  /// Auto-close warning sent for the current waitingSince period.
  autoCloseWarnedAt DateTime?

  // Relations
  messages      TicketMessage[]
  attachments   TicketAttachment[]
  inboundEmails InboundEmail[]

  closedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status, waitingSince])
  @@index([guestEmail])
  @@map("support_tickets")
}

model TicketMessage {
  id          String             @id @default(cuid())
  ticketId    String
  ticket      SupportTicket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId    String
  senderName  String
  senderRole  UserRole           @default(CUSTOMER)
  message     String
  /// Legacy: file NAMES only ({ name, size, type }[]); contents were never
  /// uploaded. New files live in TicketAttachment.
  attachments Json               @default("[]")
  source      TicketSource       @default(WEB)
  files       TicketAttachment[]
  createdAt   DateTime           @default(now())

  @@map("ticket_messages")
}

/// A file uploaded to a ticket message. The bytes live in the storage driver
/// (src/lib/storage) under a random key; fileName is display-only.
model TicketAttachment {
  id            String        @id @default(cuid())
  ticketId      String
  ticket        SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  messageId     String
  message       TicketMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  fileName      String
  /// MIME type detected from the file's magic bytes (not the client's claim).
  mimeType      String
  sizeBytes     Int
  storageDriver String
  storageKey    String        @unique
  sha256        String
  createdAt     DateTime      @default(now())

  @@index([ticketId])
  @@index([messageId])
  @@map("ticket_attachments")
}

/// Staff reply templates; body may use {{customer.name}} style variables.
model CannedReply {
  id          String            @id @default(cuid())
  title       String
  body        String
  department  TicketDepartment?
  usageCount  Int               @default(0)
  createdById String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@map("canned_replies")
}

/// IMAP mailbox polled into tickets (src/lib/support/inbound).
model SupportMailbox {
  id              String            @id @default(cuid())
  name            String
  /// The address customers write to (loop protection: mail from it is ignored).
  address         String
  host            String
  port            Int               @default(993)
  secure          Boolean           @default(true)
  username        String
  /// Encrypted (enc:v1:… via src/lib/secrets/crypto).
  password        String
  folder          String            @default("INBOX")
  /// Processed mail is moved here when set; otherwise it is only flagged \Seen.
  processedFolder String?
  department      TicketDepartment?
  isActive        Boolean           @default(true)
  lastPolledAt    DateTime?
  lastError       String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  inboundEmails InboundEmail[]

  @@map("support_mailboxes")
}

/// One received e-mail (dedupe by Message-ID) and what became of it.
model InboundEmail {
  id              String             @id @default(cuid())
  messageId       String             @unique
  mailboxId       String?
  mailbox         SupportMailbox?    @relation(fields: [mailboxId], references: [id], onDelete: SetNull)
  fromAddress     String
  fromName        String?
  subject         String
  status          InboundEmailStatus
  reason          String?
  /// Processing attempts (FAILED is retried on the next polls up to a limit).
  attempts        Int                @default(1)
  ticketId        String?
  ticket          SupportTicket?     @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  ticketMessageId String?
  receivedAt      DateTime
  createdAt       DateTime           @default(now())

  @@index([fromAddress, createdAt])
  @@index([mailboxId, createdAt])
  @@map("inbound_emails")
}

