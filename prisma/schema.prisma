  displayOrder  Int     @default(0)

  /// Registrar cost per year in `costCurrency` (Gri price list or entered by
  /// an admin). Sale prices above are TRY and KDV-exclusive; the suggested
  /// sale price is cost × TCMB rate + margin (src/lib/fx/tld-pricing.ts).
  /// NULL = cost unknown, no suggestion.
  costRegister  Decimal?  @db.Decimal(14, 4)
  costRenew     Decimal?  @db.Decimal(14, 4)
  costTransfer  Decimal?  @db.Decimal(14, 4)
  /// ISO 4217 code (USD, EUR, GBP or TRY).
  costCurrency  String    @default("USD")
  costUpdatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("domain_tlds")
}

/// One TCMB daily bulletin rate (TRY per 1 unit of `currency`), written by the
/// `fx-rates` cron (src/lib/fx/sync.ts). `date` is the bulletin date; on
/// weekends/holidays no new bulletin exists and the last one stays in effect
/// (getRate falls back to the latest prior date).
model ExchangeRate {
  id              String   @id @default(cuid())
  currency        String
  date            DateTime @db.Date
  /// ForexBuying (Döviz Alış).
  buying          Decimal  @db.Decimal(18, 6)
  /// ForexSelling (Döviz Satış) — used for cost conversion.
  selling         Decimal  @db.Decimal(18, 6)
  /// BanknoteSelling (Efektif Satış), when published.
  banknoteSelling Decimal? @db.Decimal(18, 6)
  source          String   @default("TCMB")
  bulletinNo      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([currency, date])
  @@map("exchange_rates")
}

// =====================
// BACKGROUND JOBS / CRON RUN LOG
// =====================
// The job queue itself lives in the `pgboss` schema (managed by pg-boss, not
// Prisma). These tables are the app-side run log and worker liveness record.

enum CronRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
  LOCKED
  SKIPPED
}

model CronRun {
  id         String        @id @default(cuid())
  job        String
  status     CronRunStatus @default(RUNNING)
  startedAt  DateTime      @default(now())
  finishedAt DateTime?
  durationMs Int?
  summary    Json?
  error      String?

  @@index([job, startedAt])
  @@index([startedAt])
  @@map("cron_runs")
}

model JobWorkerHeartbeat {
  /// "drain" for the in-app cron drain, "worker:<hostname>" for a worker process.
  id         String   @id
  kind       String
  startedAt  DateTime @default(now())
  lastSeenAt DateTime
  info       Json?

  @@map("job_worker_heartbeats")
}

/// One outgoing notification (one channel, one recipient). Rows are written
/// by sendNotification() and delivered by the "notification.send" queue job.
model NotificationLog {
  id                String                @id @default(cuid())
  userId            String?
  user              User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  template          String
  channel           NotificationChannel   @default(EMAIL)
  to                String
  subject           String                @default("")
  status            NotificationLogStatus @default(QUEUED)
  error             String?
  providerMessageId String?
  /// Template data; keys the template marks sensitive are encrypted (enc:v1:)
  data              Json                  @default("{}")
  /// True when the template carries secrets (password, reset link)
  redacted          Boolean               @default(false)
  /// Idempotency key (e.g. "invoice.reminder:<invoiceId>"); one row per key + channel
  dedupeKey         String?
  attempts          Int                   @default(0)
  resendOfId        String?
  inboxMessageId    String?
  sentAt            DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@unique([dedupeKey, channel])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([template, createdAt])
  @@index([status, createdAt])
  @@map("notification_logs")
}

// =====================
// LEGAL DOCUMENTS / CONSENT RECORDS
// =====================

enum LegalDocumentType {
  DISTANCE_SALES_CONTRACT
  PRELIMINARY_INFORMATION
  KVKK_NOTICE
  /// KVKK açık rıza for identity documents (KYC upload).
  KYC_CONSENT
}

/// Versioned legal text. `content` is an HTML template; `{{...}}` variables are
/// filled per order (see src/lib/legal/render.ts). A published version is never
/// edited: publish a new version instead, consent records point at the exact one.
model LegalDocument {
  id            String            @id @default(cuid())
  type          LegalDocumentType
  version       Int
  title         String
  content       String            @db.Text
  /// True for placeholder texts that still need legal review.
  isPlaceholder Boolean           @default(false)
  publishedAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  consents ConsentRecord[]

  @@unique([type, version])
  @@index([type, publishedAt])
  @@map("legal_documents")
}

/// Proof that a user accepted a specific legal document version: at checkout
/// one row per (order, document), at registration one KVKK row (orderId null).
model ConsentRecord {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId         String?
  order           Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  documentId      String
  document        LegalDocument     @relation(fields: [documentId], references: [id])
  documentType    LegalDocumentType
  documentVersion Int
  /// sha256 (hex) of `snapshot`, the exact text the user was shown/accepted.
  snapshotHash    String
  snapshot        String            @db.Text
  ipAddress       String?
  userAgent       String?
  acceptedAt      DateTime          @default(now())

  @@unique([orderId, documentId])
  @@index([userId, acceptedAt])
  @@index([documentId])
  @@map("consent_records")
}

// =====================
// MODULES (Faz 2.1) — docs/modules.md
// =====================

enum ModuleKind {
  payment
  registrar
  server
  dns
  sms
  mail
  einvoice
  storage
}

enum ModuleHealthStatus {
  UNKNOWN
  OK
  ERROR
}

/// A configured copy of a module (e.g. two WHM servers, two Proxmox nodes).
/// `config` is the manifest's configSchema output; fields listed in the
/// manifest's secretFields are stored encrypted ("enc:v1:…", src/lib/secrets).
model ModuleInstance {
  id           String     @id @default(cuid())
  kind         ModuleKind
  moduleId     String // manifest id: "cpanel-whm", "proxmox", "gri", "cloudflare" …
  label        String
  config       Json       @default("{}")
  isActive     Boolean    @default(true)
  /// Lower value = preferred when several instances qualify.
  priority     Int        @default(0)
  /// Instances sharing a groupKey (same moduleId) form a pool; a product bound
  /// to one member provisions on the least loaded active member.
  groupKey     String?
  /// Max services (accounts / VMs) for least-loaded selection; NULL = no limit.
  capacity     Int?
  /// Set for instances mirrored from the legacy Setting keys ("cpanel",
  /// "registrar", "vps_vds"): their config is re-synced from Settings when the
  /// /yonetim/entegrasyonlar form is saved.
  legacySource String?    @unique

  lastHealthAt     DateTime?
  lastHealthStatus ModuleHealthStatus @default(UNKNOWN)
  lastHealthError  String?

  products   Product[]
  services   Service[]
  servers    Server[]
  ipPools    IpPool[]
  dnsZones   DnsZone[]
  domains    Domain[]
  importRuns ImportRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind, isActive])
  @@index([moduleId])
  @@map("module_instances")
}

// =====================
// IPAM (Faz 2.4)
// =====================

enum IpAddressStatus {
  FREE
  ASSIGNED
  RESERVED
}

model IpPool {
  id                     String          @id @default(cuid())
  name                   String
  /// IPv4 network, e.g. "188.132.235.0/24".
  cidr                   String
  gateway                String
  prefix                 Int
  netmask                String
  dnsServers             String[]        @default([])
  vlan                   Int?
  moduleInstanceId       String?
  moduleInstance         ModuleInstance? @relation(fields: [moduleInstanceId], references: [id], onDelete: SetNull)
  /// Minutes a released address stays unallocatable (ARP caches, abuse lists).
  releaseCooldownMinutes Int             @default(0)
  notes                  String?
  addresses              IpAddress[]
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  @@index([moduleInstanceId])
  @@map("ip_pools")
}

model IpAddress {
  id            String          @id @default(cuid())
  poolId        String
  pool          IpPool          @relation(fields: [poolId], references: [id], onDelete: Cascade)
  /// Dotted IPv4; unique across all pools so one address can't be sold twice.
  address       String          @unique
  /// IPv4 as an integer, for ordered allocation and range queries.
  sortKey       BigInt
  status        IpAddressStatus @default(FREE)
  serviceId     String?
  service       Service?        @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  assignedAt    DateTime?
  releasedAt    DateTime?
  /// A FREE address is not handed out before this moment.
  cooldownUntil DateTime?
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([poolId, status, sortKey])
  @@index([serviceId])
  @@map("ip_addresses")
}

// =====================
// IMPORTS (Faz 2.7)
// =====================

enum ImportSourceKind {
  WHM
  PROXMOX
  REGISTRAR
}

enum ImportRunStatus {
  /// Created, waiting for the import.fetch job.
  QUEUED
  FETCHING
  /// Rows written; admin reviews the preview.
  READY
  /// import.apply job running.
  IMPORTING
  COMPLETED
  FAILED
}

enum ImportRowStatus {
  PENDING
  IMPORTED
  /// Existing legacy service bound to the instance (no new row).
  LINKED
  SKIPPED
  FAILED
}

/// One import of existing infrastructure (WHM accounts, Proxmox VMs,
/// registrar domains) into KLEACORE: who started it, the source instance,
/// counts. Nothing is ever written to the remote system.
model ImportRun {
  id               String           @id @default(cuid())
  source           ImportSourceKind
  moduleInstanceId String?
  moduleInstance   ModuleInstance?  @relation(fields: [moduleInstanceId], references: [id], onDelete: SetNull)
  /// Instance label at creation (kept when the instance is deleted).
  instanceLabel    String           @default("")
  status           ImportRunStatus  @default(QUEUED)
  createdById      String?
  createdBy        User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  appliedById      String?
  /// Send "account.invite" to customers created by this run.
  sendInvites      Boolean          @default(true)
  error            String?
  totalCount       Int              @default(0)
  importedCount    Int              @default(0)
  linkedCount      Int              @default(0)
  skippedCount     Int              @default(0)
  failedCount      Int              @default(0)
  createdCustomers Int              @default(0)
  fetchedAt        DateTime?
  appliedAt        DateTime?
  rows             ImportRow[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([createdAt])
  @@map("import_runs")
}

/// One remote record of an ImportRun: the fetched data, the proposed
/// (admin-editable) mapping and the per-row result. Ids of created rows are
/// plain strings so the audit survives deletions.
model ImportRow {
  id              String          @id @default(cuid())
  runId           String
  run             ImportRun       @relation(fields: [runId], references: [id], onDelete: Cascade)
  /// WHM username / VMID / domain name.
  remoteId        String
  /// Display label (domain, VM name).
  label           String          @default("")
  /// Normalised remote record (src/lib/imports/types.ts).
  data            Json
  /// Proposed mapping, edited by the admin before importing.
  proposal        Json
  selected        Boolean         @default(false)
  status          ImportRowStatus @default(PENDING)
  error           String?
  /// Warnings of the last apply (IP left untouched, …).
  warnings        String[]        @default([])
  serviceId       String?
  domainId        String?
  customerId      String?
  createdCustomer Boolean         @default(false)
  importedAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([runId, remoteId])
  @@index([runId, status])
  @@map("import_rows")
}

// =====================
// DOMAIN EVENTS (transactional outbox, Faz 3.1)
// =====================

enum EventDeliveryStatus {
  PENDING
  DELIVERED
  SKIPPED
  FAILED
}

/// One business fact ("invoice.paid"), written in the same transaction as the
/// change that caused it (src/lib/events/emit.ts). The events.dispatch job hands
/// it to every subscriber registered in code; processedAt is set once all of
/// them delivered (or skipped).
model DomainEvent {
  id            String          @id @default(cuid())
  /// Catalogue key, e.g. "invoice.paid" (src/lib/events/catalog.ts)
  type          String
  aggregateType String
  aggregateId   String
  /// Validated payload; keys the catalogue marks sensitive are encrypted (enc:v1:)
  payload       Json            @default("{}")
  /// User who caused the event (admin, customer, or null for cron/system)
  actorId       String?
  occurredAt    DateTime        @default(now())
  processedAt   DateTime?
  attempts      Int             @default(0)
  lastError     String?
  deliveries    EventDelivery[]

  @@index([processedAt, occurredAt])
  @@index([type, occurredAt])
  @@index([aggregateType, aggregateId])
  @@index([occurredAt])
  @@map("domain_events")
}

/// Per-subscriber delivery record: a retry skips subscribers already DELIVERED/SKIPPED.
model EventDelivery {
  id          String              @id @default(cuid())
  eventId     String
  event       DomainEvent         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  subscriber  String
  status      EventDeliveryStatus @default(PENDING)
  attempts    Int                 @default(0)
  lastError   String?
  result      Json?
  deliveredAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([eventId, subscriber])
  @@index([status, updatedAt])
  @@map("event_deliveries")
}

// =====================
// NOTIFICATION TEMPLATES (admin overrides, Faz 3.2)
// =====================

/// Admin override of a typed TS template (src/lib/notifications/templates). The
/// TS template stays the default; an active row replaces its subject/body for
/// that channel. Bodies use the safe {{variable}} syntax (overrides.ts).
model NotificationTemplate {
  id        String                        @id @default(cuid())
  key       String
  channel   NotificationChannel
  locale    String                        @default("tr")
  /// E-mail subject (empty for SMS)
  subject   String                        @default("")
  /// E-mail: inner HTML placed into the branded layout
  bodyHtml  String                        @default("")
  /// E-mail: plain-text alternative; SMS: the message
  bodyText  String                        @default("")
  /// Variables documented at save time (name → description)
  variables Json                          @default("{}")
  isActive  Boolean                       @default(true)
  version   Int                           @default(1)
  updatedBy String?
  createdAt DateTime                      @default(now())
  updatedAt DateTime                      @updatedAt
  versions  NotificationTemplateVersion[]

  @@unique([key, channel, locale])
  @@map("notification_templates")
}

/// Snapshot of every saved version (history + restore).
model NotificationTemplateVersion {
  id         String               @id @default(cuid())
  templateId String
  template   NotificationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  version    Int
  subject    String               @default("")
  bodyHtml   String               @default("")
  bodyText   String               @default("")
  isActive   Boolean              @default(true)
  /// "save" | "revert" | "restore"
  action     String               @default("save")
  updatedBy  String?
  createdAt  DateTime             @default(now())

  @@unique([templateId, version])
  @@map("notification_template_versions")
}

// =====================
// SAVED CARDS + AUTOMATIC COLLECTION (Faz 3.7) — docs/payments-saved-cards.md
// =====================

enum SavedCardStatus {
  /// Consent recorded, 1 TL 3D verification started at the gateway.
  PENDING
  ACTIVE
  EXPIRED
  /// Verification failed or the gateway did not return a card.
  FAILED
  /// Removed by the customer (and at the gateway); tokens wiped.
  DELETED
}

/// A card stored AT THE GATEWAY. We keep only the gateway's tokens (encrypted,
/// enc:v1:) and display data — never the card number or CVV.
model SavedCard {
  id                     String          @id @default(cuid())
  userId                 String
  user                   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "paytr" (iyzico possible later; see docs).
  gateway                String
  /// PayTR utoken / iyzico cardUserKey — encrypted. Empty until verified/after delete.
  gatewayCustomerRef     String          @default("")
  /// PayTR ctoken / iyzico cardToken — encrypted. Empty until verified/after delete.
  cardToken              String          @default("")
  last4                  String          @default("")
  /// Card scheme: VISA, MASTERCARD, TROY, AMEX…
  brand                  String          @default("")
  /// Card program (bonus, world, maximum…) when the gateway reports it.
  cardProgram            String?
  expMonth               Int?
  expYear                Int?
  bankName               String?
  /// PayTR require_cvv: the card can't be charged without the customer.
  requireCvv             Boolean         @default(false)
  isDefault              Boolean         @default(false)
  status                 SavedCardStatus @default(PENDING)
  /// Explicit consent to store the card and charge it automatically.
  consentAt              DateTime
  consentIp              String?
  consentUserAgent       String?
  /// Exact consent text shown to the customer.
  consentText            String          @db.Text
  /// Gateway order id of the verification charge (1 TL, refunded).
  verificationRef        String?         @unique
  /// The 1 TL verification sale went through (money to refund).
  verificationChargedAt  DateTime?
  verificationRefundedAt DateTime?
  failureReason          String?
  expiryNoticeSentAt     DateTime?
  deletedAt              DateTime?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  attempts PaymentAttempt[]

  @@index([userId, status])
  @@index([status, expYear, expMonth])
  @@map("saved_cards")
}

enum PaymentAttemptKind {
  /// Daily automatic collection.
  AUTO
  /// Customer clicked "Kayıtlı kartla öde".
  MANUAL
}

enum PaymentAttemptStatus {
  PENDING
  SUCCEEDED
  FAILED
  /// Gateway outcome unknown (timeout / wait_callback); the callback settles it.
  UNKNOWN
}

/// One charge of a stored card for an invoice. `idempotencyKey` is
/// "auto:<invoiceId>:<YYYY-MM-DD>" for the daily job, so a second run on the
/// same day can never charge the invoice again.
model PaymentAttempt {
  id             String               @id @default(cuid())
  idempotencyKey String               @unique
  kind           PaymentAttemptKind
  invoiceId      String
  invoice        Invoice              @relation(fields: [invoiceId], references: [id])
  userId         String
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  savedCardId    String?
  savedCard      SavedCard?           @relation(fields: [savedCardId], references: [id], onDelete: SetNull)
  gateway        String
  /// Gateway order id (PayTR merchant_oid) = Payment.transactionId.
  gatewayRef     String               @unique
  amount         Decimal              @db.Decimal(14, 2)
  status         PaymentAttemptStatus @default(PENDING)
  errorCode      String?
  errorMessage   String?
  createdAt      DateTime             @default(now())
  finishedAt     DateTime?

  @@index([invoiceId, kind, status])
  @@index([userId, createdAt])
  @@map("payment_attempts")
}

// =====================
// FRAUD REVIEW + KYC (Faz 4) — docs/fraud-kyc.md
// =====================

enum FraudCheckStatus {
  /// Score below the review threshold.
  PASSED
  /// Waiting for staff (İnceleme bekliyor).
  REVIEW
  APPROVED
  REJECTED
}

/// Risk evaluation of one order: evaluated at checkout, re-evaluated with the
/// card data the gateway reports at payment. `rules` is the score breakdown.
model FraudCheck {
  id              String           @id @default(cuid())
  orderId         String           @unique
  order           Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId      String
  score           Int
  threshold       Int
  status          FraudCheckStatus
  /// Score reached the block threshold: no payment is taken until approved.
  paymentBlocked  Boolean          @default(false)
  /// [{ rule, label, weight, matched, detail? }]
  rules           Json
  ipAddress       String?
  ipCountry       String?
  /// "cf-header" | "db" | null (unknown)
  ipCountrySource String?
  cardCountry     String?
  /// Last evaluation: "checkout" | "payment"
  stage           String           @default("checkout")
  reviewedBy      String?
  reviewedAt      DateTime?
  reviewNote      String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([ipAddress, createdAt])
  @@index([customerId])
  @@map("fraud_checks")
}

/// Offline IP → country table (db-ip.com "IP to Country Lite", CC BY 4.0),
/// loaded by scripts/load-ip-country-db.mjs. Addresses as integers.
model IpCountryRange {
  /// 4 or 6
  version Int
  ipFrom  Decimal @db.Decimal(39, 0)
  ipTo    Decimal @db.Decimal(39, 0)
  country String  @db.Char(2)

  @@id([version, ipFrom])
  @@map("ip_country_ranges")
}

enum KycStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum KycDocumentType {
  IDENTITY_FRONT
  IDENTITY_BACK
  TAX_CERTIFICATE
  SELFIE
}

/// Identity document uploaded for KYC. Private storage object; only the owner
/// and staff with kyc.review can read it. After a rejection the file is
/// deleted `kyc_rejected_retention_days` later (row kept, `deletedAt` set).
model KycDocument {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          KycDocumentType
  fileName      String
  mimeType      String
  sizeBytes     Int
  sha256        String
  storageDriver String
  storageKey    String
  uploadedAt    DateTime        @default(now())
  /// Set on rejection: the retention job deletes the file after this date.
  deleteAfter   DateTime?
  deletedAt     DateTime?

  @@index([userId, uploadedAt])
  @@index([deleteAfter])
  @@map("kyc_documents")
}
